{
  "expo": {
    "name": "스탬핏",
    "slug": "stampfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stampfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.jinhaeom.stampfit",
      "appleTeamId": "DNPA47GWF6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.jinhaeom.stampfit",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MyHealthWidget",
              "displayName": "오늘의 운동",
              "description": "연속 기록일수와 오늘 할 운동을 한눈에 확인하세요",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-build-properties",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다.",
          "savePhotosPermission": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
