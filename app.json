{
  "expo": {
    "name": "스탬핏",
    "slug": "stampfit",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de6b5b6a-1092-4233-b208-f168e4dcfec2",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stampfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.jinhaeom.stampfit",
      "appleTeamId": "DNPA47GWF6",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "NSPhotoLibraryUsageDescription": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.jinhaeom.stampfit",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-apple-authentication"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MyHealthWidget",
              "displayName": "오늘의 운동",
              "description": "주간 목표 연속 달성과 오늘 할 운동을 한눈에 확인하세요",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-build-properties",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다.",
          "savePhotosPermission": "운동 리포트 카드를 사진첩에 저장하기 위해 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.jinhaeom.stampfit.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jinhaeom.stampfit"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "de6b5b6a-1092-4233-b208-f168e4dcfec2"
      }
    },
    "owner": "jinhaeom"
  }
}
